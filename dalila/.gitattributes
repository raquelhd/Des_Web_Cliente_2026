# Normaliza los finales de línea automáticamente
* text=auto eol=lf

# Fuerza LF en ficheros de código y texto
*.js    text eol=lf
*.ts    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf

# Ficheros binarios: Git no los modifica
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary